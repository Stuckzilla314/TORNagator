  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "firebase": "^12.13.0",
    "playwright": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1"
  },
  "scripts": {
